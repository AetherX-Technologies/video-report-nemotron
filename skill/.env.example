# Copy to .env for local runs. Keep real keys out of git.

# OpenAI-compatible text and vision providers.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Report language: auto, en, zh-CN, ja, etc.
REPORT_LANGUAGE=auto

# Optional artifact root. If empty, scripts use ./video-report-output/<source-slug>.
VIDEO_REPORT_OUTPUT_ROOT=

# Subtitle fallback ASR backend: auto or mlx-nemotron.
ASR_BACKEND=auto
MLX_ASR_MODEL=mlx-community/nemotron-3.5-asr-streaming-0.6b-8bit
